# Copy to .env for local development. Full catalog + notes: docs/33-ENVIRONMENT-VARIABLES.md
# Shared by the worker entrypoint too (added Phase 10) — same env, different process command.

NODE_ENV=development
PORT=4000

# Local dev (docker-compose postgres); Supabase pooled/direct URLs in staging/production — docs/32-DEPLOYMENT.md
DATABASE_URL="postgresql://hospital_dev:hospital_dev_password@localhost:5432/hospital_platform"
DIRECT_DATABASE_URL="postgresql://hospital_dev:hospital_dev_password@localhost:5432/hospital_platform"

# RS256 keypair — generate locally for dev, e.g.:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_PATIENT=30d
JWT_REFRESH_TOKEN_TTL_STAFF=7d

# local | supabase — see docs/21-REPORTS-AND-DOCUMENTS.md
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=hospital-platform-dev
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_ACCESS_KEY_ID=hospital_dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=hospital_dev_password
OBJECT_STORAGE_SIGNED_URL_TTL=600

EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@hospital-platform.local"
PUSH_PROVIDER_CREDENTIALS=""
SMS_PROVIDER_API_KEY=""

# Groq AI report-assist provider — docs/27-MEDICAL-AI-SAFETY.md, ADR-012. Unset disables AI_ANALYZED.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

RATE_LIMIT_REDIS_URL="redis://localhost:6379"
QUEUE_BACKEND_URL="redis://localhost:6379"

CORS_ALLOWED_ORIGINS="http://localhost:3000"

LOG_LEVEL=debug
SENTRY_DSN=""

SUPER_ADMIN_BREAK_GLASS_ENABLED=false

OBJECT_STORAGE_SIGNING_SECRET=change-me-local-signing-secret
