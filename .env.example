# Root .env.example — local development values for docker-compose services.
# Per-app runtime variables live in apps/*/.env.example — see docs/33-ENVIRONMENT-VARIABLES.md
# for the full catalog and docs/32-DEPLOYMENT.md for how these map to Supabase/Render/Vercel.
#
# This file is for LOCAL DEVELOPMENT ONLY. Never put real secrets here — this file is
# committed (placeholders only); real values go in untracked .env files.

# --- docker-compose: local Postgres (stands in for Supabase locally) ---
POSTGRES_USER=hospital_dev
POSTGRES_PASSWORD=hospital_dev_password
POSTGRES_DB=hospital_platform
POSTGRES_PORT=5432

# --- docker-compose: local MinIO (stands in for Supabase Storage locally) ---
MINIO_ROOT_USER=hospital_dev
MINIO_ROOT_PASSWORD=hospital_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
